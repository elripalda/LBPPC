# LBPPC changes to shadNet (github.com/shadps4-emu/shadNet), on top of 75edbf0 "admin api update for entitlements".
# - stun_server: a relay for players who cannot reach each other directly (one router without hairpin NAT,
#   or no UPnP), in the client's SMRL framing, only between endpoints of signed-in players.
# - cmd_account: LBP3 players count as being in the same game (its NP Communication ID from the title it signs
#   in with), so friends' in-game presence reaches each other; npTitleId as PSN names it (CUSA00473_00).
# Apply: git apply lbppc-shadnet.patch, in a shadNet checkout at that commit.
diff --git a/src/cmd_account.cpp b/src/cmd_account.cpp
index 9baf5d4..cc655d1 100644
--- a/src/cmd_account.cpp
+++ b/src/cmd_account.cpp
@@ -2,6 +2,7 @@
 // SPDX-FileCopyrightText: Copyright 2026 shadNet Project
 // SPDX-License-Identifier: GPL-2.0-or-later
 #include <tuple>
+#include <QRegularExpression>
 #include <QDateTime>
 #include <QDebug>
 #include <QTimer>
@@ -206,7 +207,10 @@ void ClientSession::RegisterOnline() {
         // The admin API may have changed it while the login was held.
         entry.matching2Access = m_db->GetMatching2Access(userId);
         // Title context reported by the emulator at login -> presence gameTitleInfo.
-        entry.npTitleId = pending.titleId;
+        // LBPPC: as PSN names it (CUSA00473_00), which the game compares; clients report the serial alone.
+        entry.npTitleId = QRegularExpression(QStringLiteral("^[A-Z]{4}[0-9]{5}$")).match(pending.titleId).hasMatch()
+                              ? pending.titleId + QStringLiteral("_00")
+                              : pending.titleId;
         entry.titleName = pending.titleName;
         entry.clientVersion = m_reportedVersion;
         entry.versionReported = m_versionReported;
@@ -246,6 +250,18 @@ void ClientSession::RegisterOnline() {
     // Count this authenticated session in live usage stats
     m_shared->UsageOnLogin();
 
+    // LBPPC: same-game presence (a friend's incontextInfoList, gameStatus and gameData) needs each player's NP
+    // Communication ID, which shadNet learns from commands that lead with it. LBP3 sends none (its matchmaking goes
+    // through its own server), so its players never counted as in the same game and its friends list stayed empty.
+    // The title it signs in with names the ID instead.
+    static const QHash<QString, QString> kTitleComIds = {
+        {QStringLiteral("CUSA00473"), QStringLiteral("NPWR07221_00")}, // LittleBigPlanet 3 (US)
+    };
+    if (const QString comId = kTitleComIds.value(pending.titleId.left(9)); !comId.isEmpty()) {
+        if (m_shared->UsageTouchGame(userId, comId))
+            EmitPresenceGameTitleInfo();
+    }
+
     // Notify online friends we came online -- unless Appear-Offline is set, in which case
     // we stay invisible (handled as offline by everyone else).
     if (!onlineFriendSenders.isEmpty() && !pending.appearOffline) {
diff --git a/src/stun_server.cpp b/src/stun_server.cpp
index 93d9bf6..dda1d03 100644
--- a/src/stun_server.cpp
+++ b/src/stun_server.cpp
@@ -1,5 +1,6 @@
 // SPDX-FileCopyrightText: Copyright 2026 shadNet Project
 // SPDX-License-Identifier: GPL-2.0-or-later
+#include <cstring>
 #include <QDebug>
 #include <QtEndian>
 #include "stream_extractor.h"
@@ -16,6 +17,19 @@ static QByteArray StripSignalingHeader(const QByteArray& data) {
     return data.mid(SIGNALING_HEADER.size());
 }
 
+// LBPPC: a relay for players whose packets cannot reach each other directly (two players behind one router
+// without hairpin NAT, or a router that refuses UPnP). The client's framing (SuperMedo's): "SMRL", 0x02, the
+// destination's IPv4 address and port (network order), then the packet; it is passed on as "SMRL", 0x03, the
+// sender's address and port, then the packet. Only between endpoints players have sent STUN pings from, so it
+// cannot be used to send to anyone else.
+static const QByteArray RELAY_MAGIC("SMRL", 4);
+static constexpr int RELAY_HEADER = 11;
+
+static QString PlainIPv4(const QHostAddress& address) {
+    QString text = address.toString();
+    return text.startsWith("::ffff:") ? text.mid(7) : text;
+}
+
 static QByteArray FrameSignaling(const QByteArray& payload) {
     return SIGNALING_HEADER + payload;
 }
@@ -46,6 +60,11 @@ void StunServer::OnReadyRead() {
         if (raw.isEmpty())
             continue;
 
+        if (raw.size() > RELAY_HEADER && raw.startsWith(RELAY_MAGIC)) {
+            HandleRelay(raw, sender, senderPort);
+            continue;
+        }
+
         QByteArray data = StripSignalingHeader(raw);
         if (data.isEmpty())
             continue;
@@ -97,3 +116,46 @@ void StunServer::HandleStunPing(const QByteArray& data, const QHostAddress& send
     response.append(reinterpret_cast<const char*>(&portNet), 2);
     m_socket->writeDatagram(FrameSignaling(response), sender, senderPort);
 }
+
+void StunServer::HandleRelay(const QByteArray& raw, const QHostAddress& sender, uint16_t senderPort) {
+    if (static_cast<uint8_t>(raw[4]) != 0x02)
+        return;
+    uint32_t destIpNet = 0;
+    uint16_t destPortNet = 0;
+    std::memcpy(&destIpNet, raw.constData() + 5, 4);
+    std::memcpy(&destPortNet, raw.constData() + 9, 2);
+    const QHostAddress dest(qFromBigEndian(destIpNet));
+    const uint16_t destPort = qFromBigEndian(destPortNet);
+    const QString from = PlainIPv4(sender), to = dest.toString();
+
+    QString fromNpid, toNpid;
+    {
+        QReadLocker lk(&m_shared->matching.udpLock);
+        for (auto it = m_shared->matching.udpExt.constBegin(); it != m_shared->matching.udpExt.constEnd();
+             ++it) {
+            if (it.value().first == from && it.value().second == senderPort)
+                fromNpid = it.key();
+            if (it.value().first == to && it.value().second == destPort)
+                toNpid = it.key();
+        }
+    }
+    if (fromNpid.isEmpty() || toNpid.isEmpty() || fromNpid == toNpid)
+        return;
+
+    const uint32_t senderIpNet = qToBigEndian(static_cast<uint32_t>(QHostAddress(from).toIPv4Address()));
+    const uint16_t senderPortNet = qToBigEndian(senderPort);
+    QByteArray out;
+    out.reserve(raw.size());
+    out.append(RELAY_MAGIC);
+    out.append(static_cast<char>(0x03));
+    out.append(reinterpret_cast<const char*>(&senderIpNet), 4);
+    out.append(reinterpret_cast<const char*>(&senderPortNet), 2);
+    out.append(raw.constData() + RELAY_HEADER, raw.size() - RELAY_HEADER);
+    m_socket->writeDatagram(out, dest, destPort);
+
+    const QString pair = fromNpid + QStringLiteral(" -> ") + toNpid;
+    if (!m_relayedPairs.contains(pair)) {
+        m_relayedPairs.insert(pair);
+        qInfo().noquote() << "Relay: first packet" << pair;
+    }
+}
