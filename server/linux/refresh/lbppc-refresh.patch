+    /// <summary>
+    /// Fetches a file from the first mirror that has it, checks it is the file the hash names, and keeps it
+    /// at its path. One fetch per hash at a time; false if no mirror has it.
+    /// </summary>
+    private bool Fetch(string key, string path)
+    {
+        if (this._config.RemoteUrls.Count == 0)
+            return false;
+        if (this._misses.TryGetValue(key, out DateTimeOffset missed) && DateTimeOffset.UtcNow - missed < MissFor)
+            return false;
+
+        Lazy<bool> fetch = this._fetching.GetOrAdd(key, _ => new Lazy<bool>(() => this.FetchNow(key, path)));
+        try
+        {
+            return fetch.Value;
+        }
+        finally
+        {
+            this._fetching.TryRemove(key, out _);
+        }
+    }
+
+    private bool FetchNow(string key, string path)
+    {
+        string hash = key.ToLowerInvariant();
+        foreach (string template in this._config.RemoteUrls)
+        {
+            string url = template
+                .Replace("{hash}", hash)
+                .Replace("{h0}", hash[..1])
+                .Replace("{h01}", hash[..2])
+                .Replace("{h23}", hash.Substring(2, 2));
+            try
+            {
+                using HttpResponseMessage response = Http.GetAsync(url).GetAwaiter().GetResult();
+                if (!response.IsSuccessStatusCode)
+                    continue;
+                byte[] data = response.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult();
+                if (!Convert.ToHexString(SHA1.HashData(data)).Equals(hash, StringComparison.OrdinalIgnoreCase))
+                    continue;
+
+                Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+                string temporary = path + ".part";
+                File.WriteAllBytes(temporary, data);
+                File.Move(temporary, path, true);
+                return true;
+            }
+            catch (Exception)
+            {
+                // The next mirror.
+            }
+        }
+
+        this._misses[key] = DateTimeOffset.UtcNow;
+        return false;
+    }
