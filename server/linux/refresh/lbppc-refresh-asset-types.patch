+    /// <summary>
+    /// Whether an archived file is a type the game itself makes and shares: not Dangerous or Modded in
+    /// <see cref="AssetSafetyLevelExtensions.FromAssetType"/>. Photos, grief reports and ghosts have no LBP magic.
+    /// </summary>
+    private static bool IsServable(ReadOnlySpan<byte> data)
+    {
+        if (data.StartsWith((ReadOnlySpan<byte>)[0xFF, 0xD8, 0xFF]) ||
+            data.StartsWith((ReadOnlySpan<byte>)[0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]) ||
+            data.StartsWith("MATT"u8) || data.StartsWith("<ghost>"u8))
+            return true;
+        if (data.Length < 4)
+            return false;
+        GameAssetType? type = GameAssetTypeExtensions.LbpMagicToGameAssetType(data[..3]);
+        if (type == null || !Enum.IsDefined(typeof(GameAssetFormat), data[3]))
+            return false;
+        AssetFlags flags = AssetSafetyLevelExtensions.FromAssetType(type.Value, (GameAssetFormat)data[3]);
+        return (flags & (AssetFlags.Dangerous | AssetFlags.Modded)) == 0;
+    }
